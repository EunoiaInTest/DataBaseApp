#name: dodge blocks

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neckhurt Dodger</title>
<style>
  body {
    margin: 0;
    background: #0f172a;
    color: #fff;
    font-family: system-ui, Arial;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
    touch-action: none;
  }
  canvas {
    background: #1e293b;
    border: 3px solid #38bdf8;
    border-radius: 12px;
    max-width: 100vw;
    max-height: 100vh;
  }
  #ui {
    position: absolute;
    top: 20px;
    width: 100%;
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    pointer-events: none;
  }
  #hint {
    position: absolute;
    bottom: 20px;
    width: 100%;
    text-align: center;
    font-size: 14px;
    opacity: 0.7;
    pointer-events: none;
  }
</style>
</head>
<body>
<div id="ui">Score: 0</div>
<canvas id="game"></canvas>
<div id="hint">Drag to move • Tap to restart</div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const ui = document.getElementById('ui');

// make canvas fit phone screen
function resize() {
  canvas.width = Math.min(400, window.innerWidth - 20);
  canvas.height = Math.min(600, window.innerHeight - 40);
}
resize();
window.addEventListener('resize', resize);

let player = {x: 180, y: 0, w: 40, h: 40, speed: 8};
let blocks = [];
let score = 0;
let gameOver = false;
let spawnTimer = 0;
let touchX = null;

player.y = canvas.height - 60; // keep player near bottom

// Touch controls
canvas.addEventListener('touchstart', e => {
  touchX = e.touches[0].clientX;
  if (gameOver) restart();
});
canvas.addEventListener('touchmove', e => {
  touchX = e.touches[0].clientX;
});
canvas.addEventListener('touchend', () => touchX = null);

// Also keep keyboard for testing on desktop
let keys = {};
document.addEventListener('keydown', e => keys[e.key] = true);
document.addEventListener('keyup', e => keys[e.key] = false);

function spawnBlock() {
  blocks.push({
    x: Math.random() * (canvas.width - 30),
    y: -30,
    w: 30,
    h: 30,
    speed: 3 + Math.random() * 3 + score/2000
  });
}

function restart() {
  blocks = [];
  score = 0;
  gameOver = false;
  player.x = canvas.width/2 - player.w/2;
}

function update() {
  if (gameOver) return;

  // movement: touch or keys
  if (touchX!== null) {
    player.x = touchX - player.w/2;
  }
  if (keys['ArrowLeft'] || keys['a']) player.x -= player.speed;
  if (keys['ArrowRight'] || keys['d']) player.x += player.speed;

  player.x = Math.max(0, Math.min(canvas.width - player.w, player.x));

  // spawn blocks
  spawnTimer++;
  if (spawnTimer > 35) {
    spawnBlock();
    spawnTimer = 0;
  }

  // update blocks
  blocks.forEach(b => b.y += b.speed);
  blocks = blocks.filter(b => b.y < canvas.height);

  // collision
  blocks.forEach(b => {
    if (player.x < b.x + b.w && player.x + player.w > b.x &&
        player.y < b.y + b.h && player.y + player.h > b.y) {
      gameOver = true;
    }
  });

  score++;
  ui.textContent = `Score: ${Math.floor(score/10)}`;
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // player
  ctx.fillStyle = '#38bdf8';
  ctx.fillRect(player.x, player.y, player.w, player.h);

  // blocks
  ctx.fillStyle = '#f87171';
  blocks.forEach(b => ctx.fillRect(b.x, b.y, b.w, b.h));

  if (gameOver) {
    ctx.fillStyle = 'rgba(0,0,0,0.6)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 28px Arial';
    ctx.fillText('GAME OVER', canvas.width/2 - 80, canvas.height/2);
    ctx.font = '16px Arial';
    ctx.fillText('Tap to restart', canvas.width/2 - 60, canvas.height/2 + 30);
  }
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
