<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Center Input</title>
<style>
  body{
    margin:0;
    height:100vh;
    background:#0f172a;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:system-ui;
  }
  input{
    width:280px;
    padding:14px 18px;
    font-size:18px;
    border:2px solid #38bdf8;
    border-radius:12px;
    background:#1e293b;
    color:#fff;
    outline:none;
    text-align:center;
  }
  input:focus{
    border-color:#7dd3fc;
    box-shadow:0 0 15px #38bdf820;
  }
  input::placeholder{color:#64748b}
</style>
</head>
<body>
  <input type="text" placeholder="type something..." />
</body>
</html>
